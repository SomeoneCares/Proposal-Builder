# Proposal Builder settings. Copy to .env (start.sh does this and generates the password).
# Never commit .env.

# Password for the Module Library editor. Empty = editing disabled (building still works).
PROPOSAL_EDITOR_PASSWORD=

# Where the builder listens on this host. Use 127.0.0.1 behind a reverse proxy.
PROPOSAL_BUILDER_BIND=0.0.0.0
PROPOSAL_BUILDER_PORT=8501

# Optional customer research through a Hermes API server (OpenAI-compatible).
# Leave empty to switch the research panel off. The Hermes API must be reachable
# from this host, e.g. http://hermes-host:8642/v1/chat/completions
HERMES_API_URL=
HERMES_API_KEY=
