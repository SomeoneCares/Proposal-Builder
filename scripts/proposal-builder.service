# systemd user unit for the builder; scripts/deploy.sh installs it to
# ~/.config/systemd/user/proposal-builder.service on the lab host.
[Unit]
Description=VertoWave Proposal Builder (Streamlit, port 8501)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/.hermes/skills/proposal-template
Environment=PATH=/home/hermes/proposal-builder/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hermes/proposal-builder/venv/bin/streamlit run apps/proposal_builder.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false --server.enableXsrfProtection true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
